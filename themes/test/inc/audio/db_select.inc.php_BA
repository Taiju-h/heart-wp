				$output .= '<div class="tenpo_photo_left">';
				$output .=  '<img src="' . USER_IMG . $stenpo_id . '_photo_1.jpg" alt="'. $mtenpo['tenponame'] . '" title="' . $mtenpo['tenponame'] . '">';
				$output .= '</div>';
				$output .= ' <div class="tenpo_photo_right">';
