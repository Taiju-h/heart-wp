function heartftime($f,$m){
    $h=floor($f/100);
    $i=str_pad(floor($f%100/25*15),2,"0");
    
    
    $h2=floor($m/100);
    $i2=str_pad(floor($m%100/25*15),2,"0");
    
    
    if($f==0) return "臨時";
//    return "";
    return " {$h}:{$i}  - {$h2}:{$i2} ";
}




