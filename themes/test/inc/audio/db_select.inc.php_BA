function parsePermissionsStandalone(array $mcast) {
    $allow = [];
    $deny = [];
    $allow51 = [];
    $deny51 = [];
    $canSelect = [];

    $conditionalClassIds = [4, 6, 7, 8, 11, 13];

    $mshutuenId = $mcast['mshutuen_id'] ?? null;
    $mtenpoId = $mcast['mtenpo_id'] ?? null;

    // 通常の permissions
    if (!empty($mcast['permissions'])) {
        foreach (explode(',', $mcast['permissions']) as $permission) {
            if (strpos($permission, ':') === false) continue;
            list($classId, $status) = explode(':', $permission);
            $classId = (int)$classId;
            $allow[$classId] = ($status === 'allow') ? 1 : (($status === 'deny') ? -1 : 0);
        }
    }

    // 店舗51用の permissions
    if (!empty($mcast['permissions51'])) {
        foreach (explode(',', $mcast['permissions51']) as $permission) {
            if (strpos($permission, ':') === false) continue;
            list($classId, $status) = explode(':', $permission);
            $classId = (int)$classId;
            $allow51[$classId] = ($status === 'allow') ? 1 : (($status === 'deny') ? -1 : 0);
        }
    }

    // 双方向補完
    $allow[4] = $allow51[4] ?? ($allow[4] ?? 0);
    $allow[6] = $allow51[6] ?? ($allow[6] ?? 0);
    $allow51[7] = $allow[7] ?? ($allow51[7] ?? 0);
    $allow51[8] = $allow[8] ?? ($allow51[8] ?? 0);

    $allow51[12] = $allow51[5] ?? 0;
    $allow51[13] = $allow51[6] ?? 0;
    $allow[12] = $allow[5] ?? 0;
    $allow[13] = $allow[6] ?? 0;

    // 判定ロジック
    foreach ($allow as $classId => $status) {
        if (in_array($classId, $conditionalClassIds, true)) {
            if ($mshutuenId == 1) {
                $canSelect[$classId] = ($status === 1 || (!empty($allow51[$classId]) && $allow51[$classId] === 1)) ? 1 : -1;
            } else {
                $canSelect[$classId] = -1;
            }
        } else {
            $allowStatus = $status === 1 || (!empty($allow51[$classId]) && $allow51[$classId] === 1);
            $denyStatus = $status === -1 && (!empty($allow51[$classId]) && $allow51[$classId] === -1);

            if ($allowStatus) {
                $canSelect[$classId] = 1;
            } elseif ($denyStatus) {
                $canSelect[$classId] = -1;
            } else {
                $canSelect[$classId] = 0;
            }
        }
    }

    return compact('allow', 'allow51', 'canSelect');
}
